{
  "expo": {
    "name": "PetFace",
    "slug": "petface",
    "scheme": "petface",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F2",
    "locales": {
      "ko": "./native-locales/ko.json",
      "en": "./native-locales/en.json",
      "ja": "./native-locales/ja.json"
    },
    "ios": {
      "bundleIdentifier": "com.CHANGE_ME.petface",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.CHANGE_ME.petface",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFE9DF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFF8F2"
        }
      ],
      "expo-build-properties",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PetFace uses the camera to photograph your pet's face and analyse their mood and health signs.",
          "photosPermission": "PetFace accesses your photo library so you can choose a pet photo to analyse.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
