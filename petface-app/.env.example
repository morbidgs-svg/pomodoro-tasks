# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app.

# Cloudflare Worker URL (server/), e.g. https://petface-api.<you>.workers.dev
EXPO_PUBLIC_API_URL=
# Same value as the Worker's APP_KEY secret (optional but recommended)
EXPO_PUBLIC_APP_KEY=

# RevenueCat public SDK keys (Project settings > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=premium

# AdMob ad unit IDs (leave empty during development: Google test ads are used)
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=

# Public pages required by the App Store / Google Play
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
